{
  "name": "pixels",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WebGPU micro-voxel playground: a destructible Vegas penthouse at ~1 voxel per pixel",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.64",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
